<%= form_with model: [:admin, user], local: true, class: "space-y-5" do |f| %>
  <% if user.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-xl p-4">
      <ul class="text-sm text-red-600 space-y-1">
        <% user.errors.full_messages.each do |msg| %>
          <li>• <%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="bg-white rounded-2xl shadow-md border border-[#ede9fe] p-6 space-y-5">

    <div>
      <%= f.label :name, "Nome", class: "block text-sm font-semibold text-[#1e293b] mb-2" %>
      <%= f.text_field :name,
          class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-violet-500 focus:shadow-[0_0_0_4px_rgba(139,92,246,0.12)] transition-all",
          placeholder: "Nome completo" %>
    </div>

    <div>
      <%= f.label :email, "E-mail", class: "block text-sm font-semibold text-[#1e293b] mb-2" %>
      <%= f.email_field :email,
          class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-violet-500 focus:shadow-[0_0_0_4px_rgba(139,92,246,0.12)] transition-all",
          placeholder: "email@exemplo.com" %>
    </div>

    <div>
      <%= f.label :password, user.new_record? ? "Senha" : "Nova senha (deixe em branco para manter)", class: "block text-sm font-semibold text-[#1e293b] mb-2" %>
      <%= f.password_field :password,
          class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-violet-500 focus:shadow-[0_0_0_4px_rgba(139,92,246,0.12)] transition-all",
          autocomplete: "new-password",
          placeholder: user.new_record? ? "Mínimo 6 caracteres" : "••••••••" %>
    </div>

    <% unless user.new_record? && false %>
      <div>
        <%= f.label :password_confirmation, "Confirmar senha", class: "block text-sm font-semibold text-[#1e293b] mb-2" %>
        <%= f.password_field :password_confirmation,
            class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-violet-500 focus:shadow-[0_0_0_4px_rgba(139,92,246,0.12)] transition-all",
            autocomplete: "new-password",
            placeholder: "••••••••" %>
      </div>
    <% end %>

    <div>
      <%= f.label :role, "Perfil", class: "block text-sm font-semibold text-[#1e293b] mb-2" %>
      <%= f.select :role,
          [["Usuário (pode criar e editar prescrições)", "user"], ["Administrador (acesso total)", "admin"]],
          {},
          class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-violet-500 transition-all bg-white" %>
    </div>

  </div>

  <div class="flex items-center gap-3">
    <%= f.submit user.new_record? ? "Criar Usuário" : "Salvar Alterações",
        class: "px-6 py-2.5 bg-gradient-to-br from-violet-500 to-violet-700 text-white rounded-xl text-sm font-medium shadow-md hover:shadow-lg hover:-translate-y-px transition-all cursor-pointer" %>
    <%= link_to "Cancelar", admin_users_path,
        class: "px-6 py-2.5 border-2 border-[#e2e8f0] rounded-xl text-sm text-[#64748b] hover:border-violet-300 hover:text-violet-500 transition-all" %>
  </div>
<% end %>
