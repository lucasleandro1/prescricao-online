<div class="min-h-screen bg-[#fafbfc] flex items-center justify-center px-4">
  <div class="w-full max-w-md">

    <div class="text-center mb-8">
      <h1 class="text-2xl font-bold bg-gradient-to-br from-blue-500 to-cyan-500 bg-clip-text text-transparent mb-2">
        Arquivo de Prescrições
      </h1>
      <p class="text-sm text-[#64748b]">Acesso restrito ao administrador</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl border border-[#f1f5f9] p-8">
      <h2 class="text-lg font-semibold text-[#1e293b] mb-6">Entrar</h2>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-4" }) do |f| %>
        <div>
          <%= f.label :email, "E-mail", class: "block text-sm font-medium text-[#1e293b] mb-2" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-blue-500 focus:shadow-[0_0_0_4px_rgba(59,130,246,0.1)] transition-all" %>
        </div>

        <div>
          <%= f.label :password, "Senha", class: "block text-sm font-medium text-[#1e293b] mb-2" %>
          <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full px-4 py-2.5 text-sm border-2 border-[#e2e8f0] rounded-xl outline-none focus:border-blue-500 focus:shadow-[0_0_0_4px_rgba(59,130,246,0.1)] transition-all" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded" %>
            <%= f.label :remember_me, "Lembrar-me", class: "text-sm text-[#64748b]" %>
          </div>
        <% end %>

        <%= f.submit "Entrar", class: "w-full py-3 bg-gradient-to-br from-blue-500 to-blue-700 text-white rounded-xl text-sm font-medium shadow-md hover:shadow-lg transition-all cursor-pointer mt-2" %>
      <% end %>
    </div>

    <div class="text-center mt-4">
      <%= link_to "← Voltar ao site", root_path, class: "text-sm text-[#94a3b8] hover:text-blue-500 transition-colors" %>
    </div>
  </div>
</div>
